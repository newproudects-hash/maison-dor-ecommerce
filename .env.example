# ════════════════════════════════════════════════
# MAISON D'OR — Environment Variables Template
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git!
# ════════════════════════════════════════════════

# ─── Sanity CMS ──────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_token

# ─── Supabase ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Google Sheets ───────────────────────────────
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_private_key_here\n-----END RSA PRIVATE KEY-----"
GOOGLE_SHEET_ID=your_google_sheet_id

# ─── Admin Authentication (CHANGE THESE!) ────────
# Set a strong random token (e.g. openssl rand -hex 32)
ADMIN_SECRET_TOKEN=change_this_to_a_strong_random_token
ADMIN_EMAIL=admin@maisondor.com
ADMIN_PASSWORD=change_this_strong_password_minimum_12_chars

# ─── App ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.maisondor.dz
